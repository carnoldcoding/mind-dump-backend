# Copy to .env and fill in. .env is gitignored; this file is the record of
# what the server expects to find there.

# ── Database ──────────────────────────────────────────────────────────
MONGO_URI=
DB_NAME=

# ── Media storage (Cloudflare R2) ─────────────────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Metadata lookup ───────────────────────────────────────────────────
# Games, from IGDB: https://api-docs.igdb.com
# IGDB has no API key of its own — it authenticates with Twitch. Register an
# application at https://dev.twitch.tv/console/apps (the account needs 2FA) and
# use its Client ID and Client Secret. The server exchanges them for an access
# token itself; there is no token to paste here.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Cinema, from TMDB: https://developer.themoviedb.org
TMDB_API_KEY=
# Books come from Open Library, which needs no credentials.

# ── Server ────────────────────────────────────────────────────────────
PORT=5000
HOST=127.0.0.1
