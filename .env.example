# Copy to .env and fill in. .env is gitignored; this file is the record of
# what the server expects to find there.

# ── Database ──────────────────────────────────────────────────────────
MONGO_URI=
DB_NAME=

# ── Media storage (Cloudflare R2) ─────────────────────────────────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Metadata lookup ───────────────────────────────────────────────────
# Games, from RAWG: https://rawg.io/apidocs
RAWG_API_KEY=
# Cinema, from TMDB: https://developer.themoviedb.org
TMDB_API_KEY=
# Books come from Open Library, which needs no credentials.

# ── Server ────────────────────────────────────────────────────────────
PORT=5000
HOST=127.0.0.1
